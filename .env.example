# Kopiér til .env.local og udfyld.
NEXT_PUBLIC_SUPABASE_URL=https://dit-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Delt hemmelighed for POST /api/leads/inbound. Generér med: openssl rand -hex 32
LEAD_INTAKE_SECRET=

# Kun til scripts/import-meta-export.ts. Aldrig i klienten, aldrig i git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mail ind i korrespondancen (IMAP) ---
# Postkassen der skrives med kunder fra. Simply.com. Se docs/kommunikation.md.
IMAP_HOST=mail.simply.com
IMAP_PORT=993
IMAP_USER=tomrer@holmsmaler.dk
# Postkassens egen adgangskode. Kun i Vercel — aldrig i git.
IMAP_PASSWORD=
# Flere egne adresser, med komma imellem. Afgør hvad der er udgående mail.
# Kan stå tom; IMAP_USER tælles altid med.
MAIL_OWN_ADDRESSES=
# Hvor langt tilbage første kørsel henter. 0 = kun ny mail herfra.
MAIL_SYNC_BACKFILL_DAYS=0
# Delt hemmelighed for synk-endpointet. Generér med: openssl rand -hex 32
MAIL_SYNC_SECRET=

# --- SMS (GatewayAPI) — fase 2, ikke tændt ---
# Lades tomme indtil der er lejet et to-vejs-nummer. Uden de to første falder
# CRM'et tilbage til at åbne telefonens SMS-app, præcis som det altid har gjort.
GATEWAYAPI_TOKEN=
# Det lejede to-vejs-nummer, med landekode og uden plus. Et navn som "Holms"
# virker også, men så kan kunden ikke svare — og så bliver svaret ikke logget.
SMS_SENDER=4512345678
# Delt hemmelighed i webhook-URL'en. Generér med: openssl rand -hex 32
SMS_WEBHOOK_SECRET=

# --- Udgående mail (SMTP) ---
# Bruges af "Skriv mail" på leadet. Uden SMTP_HOST åbner knappen
# mailprogrammet med mailto: som før — så virker den, den logger bare ikke.
#
# Vigtigt: værtsnavnet er IKKE det samme som IMAP_HOST. Hos Simply er
# IMAP mail.simply.com og SMTP smtp.simply.com.
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
# Kan udelades — falder tilbage på IMAP_USER og IMAP_PASSWORD.
SMTP_USER=
SMTP_PASSWORD=
# Navnet kunden ser som afsender.
MAIL_FROM_NAME=Holms Maler & Tømrer
