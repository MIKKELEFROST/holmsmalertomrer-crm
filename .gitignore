# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Skabelonen skal med i git, selvom .env* ellers er ignoreret.
!.env.example

# Kundedata. Meta-eksporten og den genererede seed indeholder navne, mails og
# telefonnumre på rigtige personer. Git-historik kan ikke slettes igen ved en
# sletteanmodning, og filerne ville følge med til hver klon — så de bliver
# lokale. Dataen hører i databasen.
/data/meta-eksport-original.csv
/supabase/seed.sql
